
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Meu Estúdio de Quadrinhos</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#171923;color:white;font-family:Arial,sans-serif}
header{background:#252b3b;padding:20px;text-align:center}
header h1{margin:0;color:#ffd166;font-size:25px}
header p{color:#ccc;margin-bottom:0}
main{max-width:850px;margin:auto;padding:15px}
.card{background:#252b3b;padding:16px;border-radius:14px;margin:15px 0}
h2{color:#ffd166;font-size:20px}
label{display:block;margin:12px 0 6px}
input,select,textarea{width:100%;padding:12px;border:0;border-radius:8px;font-size:16px}
textarea{min-height:90px}
button{background:#ffd166;color:#171923;border:0;padding:12px 16px;border-radius:9px;font-weight:bold;font-size:15px;margin:5px 3px;cursor:pointer}
button.secondary{background:#586174;color:white}
#pages{display:grid;grid-template-columns:1fr;gap:15px}
.panel{background:white;color:#222;border:5px solid #222;border-radius:5px;min-height:190px;padding:12px;position:relative}
.panel .scene{font-size:48px;text-align:center;padding:12px}
.panel textarea{border:1px solid #aaa;min-height:55px}
.bubble{background:#fff;border:2px solid #222;border-radius:22px;padding:10px;text-align:center;color:#111;margin:8px auto;max-width:90%;font-weight:bold}
.small{color:#bbb;font-size:13px}
footer{text-align:center;color:#aaa;padding:20px}
@media(min-width:600px){#pages{grid-template-columns:1fr 1fr}}
@media print{
body{background:white;color:black}
header,.card.controls,footer,.no-print{display:none!important}
#pages{display:block}
.panel{break-inside:avoid;margin:10px auto;max-width:700px;min-height:220px}
.panel textarea{display:none}
}
</style>
</head>
<body>
<header>
<h1>🎨 Meu Estúdio de Quadrinhos</h1>
<p>Crie suas próprias histórias!</p>
</header>
<main>
<section class="card controls">
<h2>📚 Criar uma história</h2>
<label>Nome da história</label>
<input id="title" placeholder="Ex.: A aventura do herói">
<label>Escolha o estilo</label>
<select id="style">
<option>Gibi tradicional</option>
<option>Super-heróis</option>
<option>Mangá japonês</option>
<option>Cartoon</option>
</select>
<label>Personagem principal</label>
<input id="hero" placeholder="Ex.: Capitão Marcelo">
<label>Conte sua história</label>
<textarea id="story" placeholder="Escreva aqui o que acontece na aventura..."></textarea>
<button onclick="generate()">✨ Criar cenas</button>
<button class="secondary" onclick="addPanel()">+ Nova cena</button>
<button class="secondary" onclick="save()">💾 Salvar</button>
<button class="secondary" onclick="load()">📂 Abrir salva</button>
<button class="secondary" onclick="window.print()">📄 Exportar PDF</button>
<p class="small">O gerador inicial organiza seu texto em cenas. A geração de ilustrações por IA será integrada numa próxima etapa.</p>
</section>

<h2 id="comicTitle">Meu quadrinho</h2>
<div id="pages"></div>
</main>
<footer>Meu Estúdio de Quadrinhos • Versão 1.0</footer>

<script>
let scenes=[];

function addPanel(text="Nova cena",dialogue="Escreva a fala do personagem"){
 scenes.push({text,dialogue});
 render();
}

function generate(){
 const story=document.getElementById("story").value.trim();
 const hero=document.getElementById("hero").value.trim()||"Herói";
 if(!story){alert("Escreva uma história primeiro!");return;}
 const parts=story.split(/[.!?]+/).map(x=>x.trim()).filter(Boolean);
 scenes=parts.map((part,i)=>({
 text:hero+": "+part,
 dialogue:i===0?"Minha aventura começou!":"O que vai acontecer agora?"
 }));
 if(scenes.length===0)addPanel();
 document.getElementById("comicTitle").textContent=
 document.getElementById("title").value||"Minha história";
 render();
}

function render(){
 const pages=document.getElementById("pages");
 pages.innerHTML="";
 scenes.forEach((scene,i)=>{
 const box=document.createElement("section");
 box.className="panel";
 const number=document.createElement("p");
 number.textContent="QUADRO "+(i+1);
 const art=document.createElement("div");
 art.className="scene";
 art.textContent="🎬";
 const description=document.createElement("textarea");
 description.value=scene.text;
 description.placeholder="Descreva a cena";
 description.oninput=()=>scenes[i].text=description.value;
 const bubble=document.createElement("div");
 bubble.className="bubble";
 bubble.textContent="💬 "+scene.dialogue;
 const speech=document.createElement("textarea");
 speech.value=scene.dialogue;
 speech.placeholder="Fala do personagem";
 speech.oninput=()=>{
 scenes[i].dialogue=speech.value;
 bubble.textContent="💬 "+speech.value;
 };
 const remove=document.createElement("button");
 remove.className="secondary no-print";
 remove.textContent="Excluir quadro";
 remove.onclick=()=>{scenes.splice(i,1);render();};
 box.append(number,art,description,bubble,speech,remove);
 pages.appendChild(box);
 });
}

function save(){
 const data={
 title:document.getElementById("title").value,
 style:document.getElementById("style").value,
 hero:document.getElementById("hero").value,
 story:document.getElementById("story").value,
 scenes:scenes
 };
 localStorage.setItem("meuQuadrinho",JSON.stringify(data));
 alert("História salva neste aparelho!");
}

function load(){
 const data=localStorage.getItem("meuQuadrinho");
 if(!data){alert("Nenhuma história salva.");return;}
 const d=JSON.parse(data);
 document.getElementById("title").value=d.title||"";
 document.getElementById("style").value=d.style||"Gibi tradicional";
 document.getElementById("hero").value=d.hero||"";
 document.getElementById("story").value=d.story||"";
 scenes=d.scenes||[];
 document.getElementById("comicTitle").textContent=d.title||"Meu quadrinho";
 render();
 alert("História carregada!");
}

addPanel();
</script>
</body>
</html>
